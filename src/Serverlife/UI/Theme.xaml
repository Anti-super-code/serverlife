                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dk" Property="Fill" Value="{StaticResource Good}"/>
                            <Setter TargetName="lt" Property="Fill" Value="{StaticResource Good}"/>
                            <Setter TargetName="gear" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="glyph" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ slider with value bubble ============ -->
    <Style x:Key="InvisibleRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FillRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="12" CornerRadius="6" VerticalAlignment="Center"
                                Background="{StaticResource Accent}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BubbleThumb" TargetType="Thumb">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" ClipToBounds="False">
                        <!-- A zero-size Canvas lets the bubble measure freely instead of being
                             squeezed into the thumb's 30px slot. -->
                        <Canvas Width="0" Height="0" ClipToBounds="False"
                                HorizontalAlignment="Center" VerticalAlignment="Top">
                            <StackPanel Canvas.Left="-60" Canvas.Top="-46" Width="120">
                                <Border CornerRadius="9" Padding="11,4" Background="{StaticResource TextHi}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider},
                                                              StringFormat={}{0:0} px}"/>
                                </Border>
                                <Path Data="M0,0 L6,7 L12,0 Z" Fill="{StaticResource TextHi}"
                                      HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Canvas>
                        <Ellipse Fill="{StaticResource Surface}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowDark}" Direction="300"
                                                  ShadowDepth="2" BlurRadius="7" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Fill="White" Margin="1"/>
                        <Ellipse Width="13" Height="13" Fill="{StaticResource Accent}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeuSlider" TargetType="Slider">
        <Setter Property="Height" Value="30"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="12" CornerRadius="6" VerticalAlignment="Center"
                                Background="{StaticResource Sunken}"
                                BorderThickness="1" BorderBrush="{StaticResource InsetEdge}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource FillRepeat}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource BubbleThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ progress bar ============ -->
    <Style x:Key="NeuProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="6" Background="{StaticResource Sunken}"
                                BorderThickness="1" BorderBrush="{StaticResource InsetEdge}"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left"
                                Background="{StaticResource Accent}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ result row badge ============ -->
    <Style x:Key="ResultCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource ShadowDark}" Direction="315"
                                  ShadowDepth="2" BlurRadius="6" Opacity="0.8"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ scroll bar (slim) ============ -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#B4C0D0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
