<!--
    Serverlife's theme, carried over from Photokompressor's Theme.xaml so the two
    apps read as siblings. The palette, gradients, NeumorphicRaised shadow and
    control shapes are unchanged. Two deliberate deltas:

    1. TextMid/TextLo use the DARKENED values (#434D60 / #717D91) that the macOS
       port settled on after direct feedback that hint text was too light. The
       Windows original still has the lighter #59647A / #94A0B4; this file is the
       corrected pair, and macos/.../Theme.swift already matches.

    2. Spacing and scale are tighter. Photokompressor's tray shows 52px photo
       thumbnails for a few seconds; Serverlife is a text list that sits open all
       day, so SectionLabel 11->10, RowLabel 14.5->12.5, SunkenPanel radius
       16->10, and the segmented picker 46->28 high with radii scaled to match.
       Colour and shadow are untouched - only geometry moves.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Serverlife.UI">

    <!-- ============ typography ============ -->
    <!-- Fira Sans Condensed (SIL Open Font License) — the same family the Wind Router
         app uses — embedded in the exe so it renders identically everywhere. To swap
         in a different Google font: drop its static .ttf weights into Assets\Fonts and
         change the family name after the '#'. Segoe UI is the fallback. -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Fira Sans Condensed, Segoe UI</FontFamily>

    <!-- ============ palette ============ -->
    <SolidColorBrush x:Key="Bg" Color="#EDF1F6"/>
    <SolidColorBrush x:Key="Surface" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="Sunken" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextHi" Color="#131820"/>
    <SolidColorBrush x:Key="TextMid" Color="#434D60"/>
    <SolidColorBrush x:Key="TextLo" Color="#717D91"/>
    <SolidColorBrush x:Key="Danger" Color="#FF3B30"/>
    <SolidColorBrush x:Key="DangerDeep" Color="#E23A2E"/>
    <SolidColorBrush x:Key="Good" Color="#12B76A"/>
    <SolidColorBrush x:Key="Warn" Color="#F0A020"/>
    <!-- Darker than Bg/Surface/Sunken so the gallery tray reads as a distinct, attached panel. -->
    <SolidColorBrush x:Key="TrayBg" Color="#D3DBE6"/>

    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E6BF5" Offset="0"/>
        <GradientStop Color="#22C3E6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InsetEdge" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#C9D2E0" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <Color x:Key="ShadowDark">#C0C9D8</Color>

    <!-- ============ text ============ -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextLo}"/>
        <Setter Property="Margin" Value="2,0,0,4"/>
        <Setter Property="local:Tracking.Em" Value="0.1"/>
    </Style>

    <!-- All-caps hairline wordmark at the font's natural spacing. Tracking is off:
         raise Em (and optionally EmEnd, which ramps spacing across the word) to
         reintroduce it. -->
    <Style x:Key="Wordmark" TargetType="TextBlock">
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="ExtraLight"/>
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="local:Tracking.Em" Value="0"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ sunken container ============ -->
    <Style x:Key="SunkenPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Sunken}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource InsetEdge}"/>
    </Style>

    <!-- ============ segmented picker ============ -->
    <!-- The accent pill lives on the track, not the segment, so it can slide between
         them. Segments only own their label and hover wash. -->
    <Style x:Key="SegmentTrackStyle" TargetType="{x:Type local:SegmentTrack}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SegmentTrack}">
                    <Border Background="{StaticResource Sunken}" CornerRadius="10"
                            BorderThickness="1" BorderBrush="{StaticResource InsetEdge}">
                        <Grid x:Name="PART_Clip">
                            <Border x:Name="PART_Pill" CornerRadius="8" Opacity="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{StaticResource Accent}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#2E6BF5" Direction="270" ShadowDepth="2"
                                                      BlurRadius="10" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="hover" CornerRadius="8" Background="#FFFFFF" Opacity="0"/>
                        <TextBlock x:Name="label"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="labelBrush" Color="#434D60"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0"/>
                            <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
                            <!-- Held back briefly so the label turns white as the pill lands
                                 under it, not while it's still in transit. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="labelBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="White" BeginTime="0:0:0.05" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="labelBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#434D60" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ inline text link ============ -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="7,2">
                        <TextBlock x:Name="label"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                   FontSize="12" Foreground="{StaticResource TextLo}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="label" Property="Foreground" Value="#2E6BF5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ small chip button ============ -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="27"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="dk" CornerRadius="13" Background="{StaticResource Surface}">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowDark}" Direction="315"
                                                  ShadowDepth="2" BlurRadius="5" Opacity="0.95"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="lt" CornerRadius="13" Background="{StaticResource Surface}">
                            <Border.Effect>
                                <DropShadowEffect Color="White" Direction="135" ShadowDepth="2"
                                                  BlurRadius="4" Opacity="1"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="label" Margin="{TemplateBinding Padding}"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMid}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="label" Property="Foreground" Value="#2E6BF5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="lt" Property="Background" Value="{StaticResource Sunken}"/>
                            <Setter TargetName="dk" Property="Background" Value="{StaticResource Sunken}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ toggle switch ============ -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border CornerRadius="16" Background="{StaticResource Sunken}"
                                BorderThickness="1" BorderBrush="{StaticResource InsetEdge}"/>
                        <Border x:Name="on" CornerRadius="16" Background="{StaticResource Accent}" Opacity="0"/>
                        <Grid HorizontalAlignment="Left" Width="26" Height="26" Margin="3,0,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="slide" X="0"/>
                            </Grid.RenderTransform>
                            <Ellipse Fill="{StaticResource Surface}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{StaticResource ShadowDark}" Direction="300"
                                                      ShadowDepth="2" BlurRadius="6" Opacity="1"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Fill="White" Margin="1"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X"
                                                         To="24" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ radio row ============ -->
    <Style x:Key="RadioRow" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="row" CornerRadius="14" Padding="12,10" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" VerticalAlignment="Center">
                                <Ellipse Fill="{StaticResource Sunken}" Stroke="{StaticResource InsetEdge}"
                                         StrokeThickness="1"/>
                                <Ellipse x:Name="dot" Width="11" Height="11" Fill="{StaticResource Accent}" Opacity="0"/>
                            </Grid>
                            <TextBlock x:Name="label" Grid.Column="1" Margin="12,0,0,0"
                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontSize="14" Foreground="{StaticResource TextMid}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="#63FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextHi}"/>
                            <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="row" Property="Background" Value="#8FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ sunken text box ============ -->
    <Style x:Key="NeuTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CaretBrush" Value="#2E6BF5"/>
        <Setter Property="SelectionBrush" Value="#2E6BF5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="12" Background="{StaticResource Sunken}"
                                BorderThickness="1" BorderBrush="{StaticResource InsetEdge}"/>
                        <Border x:Name="glow" CornerRadius="12" BorderThickness="2" BorderBrush="#2E6BF5" Opacity="0"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="glow" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ primary pill button ============ -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="26" Background="{StaticResource Accent}">
                            <Border.Effect>
                                <DropShadowEffect Color="#2E6BF5" Direction="270" ShadowDepth="4"
                                                  BlurRadius="16" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="veil" CornerRadius="26" Background="White" Opacity="0"/>
                        <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="veil" Property="Opacity" Value="0.13"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="veil" Property="Opacity" Value="0"/>
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.985" ScaleY="0.94" CenterX="0" CenterY="26"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ secondary (raised, neutral) button ============ -->
    <Style x:Key="SoftButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="dk" CornerRadius="26" Background="{StaticResource Surface}">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowDark}" Direction="315"
                                                  ShadowDepth="3" BlurRadius="8" Opacity="1"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="lt" CornerRadius="26" Background="{StaticResource Surface}">
                            <Border.Effect>
                                <DropShadowEffect Color="White" Direction="135" ShadowDepth="3"
                                                  BlurRadius="7" Opacity="1"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="label" Margin="{TemplateBinding Padding}"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMid}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextHi}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="lt" Property="Background" Value="{StaticResource Sunken}"/>
                            <Setter TargetName="dk" Property="Background" Value="{StaticResource Sunken}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ round icon button (browse) ============ -->
    <Style x:Key="RoundIconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="dk" Fill="{StaticResource Surface}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowDark}" Direction="315"
                                                  ShadowDepth="2" BlurRadius="6" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="lt" Fill="{StaticResource Surface}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="White" Direction="135" ShadowDepth="2"
                                                  BlurRadius="5" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="lt" Property="Fill" Value="{StaticResource Sunken}"/>
                            <Setter TargetName="dk" Property="Fill" Value="{StaticResource Sunken}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ window close (large X) ============ -->
    <Style x:Key="CloseButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="dk" Fill="{StaticResource Surface}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowDark}" Direction="315"
                                                  ShadowDepth="3" BlurRadius="7" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="lt" Fill="{StaticResource Surface}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="White" Direction="135" ShadowDepth="3"
                                                  BlurRadius="6" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Path x:Name="glyph" Data="M0,0 L15,15 M15,0 L0,15"
                              Stroke="{StaticResource TextMid}" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dk" Property="Fill" Value="{StaticResource Danger}"/>
                            <Setter TargetName="lt" Property="Fill" Value="{StaticResource Danger}"/>
                            <Setter TargetName="glyph" Property="Stroke" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="glyph" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ tray close (large X, neutral hover) ============ -->
    <!-- Same geometry as CloseButton, but hovers dark grey instead of red — a
         secondary/tray-level close shouldn't carry the main window's "destructive" weight. -->
    <Style x:Key="TrayCloseButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="dk" Fill="{StaticResource Surface}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowDark}" Direction="315"
                                                  ShadowDepth="3" BlurRadius="7" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="lt" Fill="{StaticResource Surface}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="White" Direction="135" ShadowDepth="3"
                                                  BlurRadius="6" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Path x:Name="glyph" Data="M0,0 L15,15 M15,0 L0,15"
                              Stroke="{StaticResource TextMid}" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dk" Property="Fill" Value="{StaticResource TextMid}"/>
                            <Setter TargetName="lt" Property="Fill" Value="{StaticResource TextMid}"/>
                            <Setter TargetName="glyph" Property="Stroke" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="glyph" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ window info (i) ============ -->
    <!-- Sits beside CloseButton, so it shares its geometry exactly; only the glyph and
         the hover colour differ. The "i" is drawn rather than typed so it lines up with
         the stroked X instead of riding a text baseline. -->
    <Style x:Key="InfoButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="dk" Fill="{StaticResource Surface}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowDark}" Direction="315"
                                                  ShadowDepth="3" BlurRadius="7" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="lt" Fill="{StaticResource Surface}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="White" Direction="135" ShadowDepth="3"
                                                  BlurRadius="6" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Gear/cog — this panel now holds real settings, not just "about", so
                             the glyph matches (was a plain "i"). -->
                        <Viewbox x:Name="glyph" Width="19" Height="19"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="gear" Fill="{StaticResource TextMid}"
